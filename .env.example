# Copy this file to .env and fill in the values. Never commit .env.

# OpenAI API key used for embeddings and generation (required).
OPENAI_API_KEY=tu_api_key_aqui

# Directory containing the source .md/.txt documents (relative paths resolve from the project root).
RAG_DATA_DIR=./data

# Directory where the persistent ChromaDB index is stored (git-ignored).
RAG_VECTORSTORE_DIR=./vectorstore

# Chroma collection name shared by ingestion and querying.
RAG_COLLECTION_NAME=local_rag

# Embedding model. Re-run `python ingest.py --force` if you change it.
RAG_EMBEDDING_MODEL=text-embedding-3-small

# Chat model used for grounded answer generation.
RAG_LLM_MODEL=gpt-4o-mini

# Number of retrieved chunks. Keep between 3 and 5 to avoid Lost in the Middle.
RAG_TOP_K=4

# Chunk size in tiktoken tokens (assignment minimum: 500).
RAG_CHUNK_SIZE=500

# Overlap between consecutive chunks in tokens.
RAG_CHUNK_OVERLAP=50
